        "rootDir": "..",
        "outDir": "../dist/cjs",
        "declaration": false,
        "resolveJsonModule": true
    },
    "exclude": [
        "../node_modules",
        "../dist/**/*",
        "../test/**/*",
        "../lib/**/*.spec.ts",
        "../lib/**/*.test.ts"
    ]
