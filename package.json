{
  "name": "casl-bridge",
  "version": "1.4.2",
  "description": "A query bridge between CASL rules and database ORMs",
  "main": "./dist/cjs/lib/index.js",
  "module": "./dist/esm/lib/index.js",
  "types": "./dist/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "require": "./dist/cjs/lib/index.js",
      "import": "./dist/esm/lib/index.js"
    }
  },
  "files": [
    "dist/**",
    "index.d.ts",
    "README.md",
    "LICENSE*",
    "CHANGELOG*"
  ],
  "scripts": {
    "test": "TS_NODE_PROJECT=config/tsconfig.test.json TS_NODE_FILES=true NODE_OPTIONS=--no-warnings=MODULE_TYPELESS_PACKAGE_JSON mocha --require ts-node/register --require tsconfig-paths/register --file mocha.setup.ts 'lib/**/*.spec.ts'",
    "test:": "TS_NODE_PROJECT=config/tsconfig.test.json TS_NODE_FILES=true NODE_OPTIONS=--no-warnings=MODULE_TYPELESS_PACKAGE_JSON mocha --require ts-node/register --require tsconfig-paths/register --file mocha.setup.ts",
    "test:cov": "c8 npm run test",
    "build:cjs": "tsc -p config/tsconfig.cjs.json",
    "build:esm": "tsc -p config/tsconfig.esm.json",
    "build:types": "tsc -p config/tsconfig.types.json",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types && node scripts/postbuild.cjs",
    "lines:dev": "cloc lib",
    "lines": "cloc lib --not-match-f='\\.(spec|test)\\.ts$' --ignore-case-ext --sum-one"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TekuConcept/casl-bridge.git"
  },
  "keywords": [
    "casl",
    "orm",
    "typeorm",
    "query",
    "sql"
  ],
  "author": "Chris Walker (TekuConcept)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TekuConcept/casl-bridge/issues"
  },
  "homepage": "https://github.com/TekuConcept/casl-bridge#readme",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/chai": "^4.3.14",
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.3",
    "better-sqlite3": "^12.8.0",
    "c8": "^9.1.0",
    "chai": "^4.3.7",
    "lodash": "^4.18.1",
    "mocha": "^10.4.0",
    "mocha-chai-jest-snapshot": "^1.1.4",
    "sinon": "^17.0.1",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@casl/ability": "^6.8.0",
    "typeorm": "^0.3.28"
  },
  "jest": {
    "snapshotResolver": "<rootDir>/test/snapshot-resolver.js",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ]
  }
}
